# Copier ce fichier en .env.local (non versionné) et ajuster.

# Publicité : false par défaut. Aucun emplacement n'est rendu tant que ce
# drapeau n'est pas explicitement à "true".
# ⚠️ En Europe, un CMP de consentement certifié TCF v2.2 doit être en place
# AVANT de passer ceci à true.
VITE_ADS_ENABLED=false

# Domaine de production, utilisé par scripts/prerender.mjs pour les URL
# canoniques, les balises Open Graph et le sitemap.
# À définir aussi dans les variables d'environnement du projet Vercel.
SITE_URL=https://game-wave-3aa9.vercel.app
